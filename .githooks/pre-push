#!/usr/bin/env sh
# Run lint, type checks, and tests before pushing.
# Enable once with: git config core.hooksPath .githooks

run() {
    label=$1
    shift
    echo "→ $label"
    if ! "$@"; then
        echo
        echo "Pre-push check failed ($label). Fix it, or bypass with: git push --no-verify"
        exit 1
    fi
}

run "Ruff lint"   ruff check .
run "Ruff format" ruff format --check .
run "Mypy"        mypy
run "Tests"       pytest
